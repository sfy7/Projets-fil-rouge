pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "portfolio-backend"
        FRONTEND_IMAGE = "portfolio-frontend"
        DOCKHUB_USER   = "sfy7"
    }

    stages {

        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_creds',
                    url: 'https://github.com/sfy7/Projets-fil-rouge.git'
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🔍 Analyse SonarQube du code source
        // Utilise le scanner natif Jenkins (pas Docker)
        // Le fichier sonar-project.properties est utilisé automatiquement
        // ─────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                dir('DevOps') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            sonar-scanner -Dproject.settings=sonar-project.properties
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🧪 Quality Gate SonarQube
        // Bloque le pipeline si le code ne respecte pas les règles qualité
        // ─────────────────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🐳 Build des images Docker
        // Backend + Frontend en parallèle pour accélérer le pipeline
        // ─────────────────────────────────────────────────────────────
        stage('Build Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        dir('DevOps/Backend') {
                            sh 'docker build -t $BACKEND_IMAGE .'
                        }
                    }
                }

                stage('Build Frontend') {
                    steps {
                        dir('DevOps/Frontend') {
                            sh 'docker build -t $FRONTEND_IMAGE .'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🚀 Push des images vers Docker Hub
        // Version latest + version build number
        // ─────────────────────────────────────────────────────────────
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub_creds',
                    usernameVariable: 'DOCKHUB_USER_CRED',
                    passwordVariable: 'DOCKHUB_PASS'
                )]) {
                    sh '''
                        echo "$DOCKHUB_PASS" | docker login -u "$DOCKHUB_USER_CRED" --password-stdin

                        docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}
                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}

                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:latest
                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:latest
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}

                        docker logout
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 📦 Déploiement des containers via docker compose
        // Utilise fichier .env injecté via Jenkins credentials
        // ─────────────────────────────────────────────────────────────
        stage('Start Containers') {
            steps {
                withCredentials([file(credentialsId: 'portfolio-env', variable: 'ENV_FILE')]) {
                    dir('DevOps') {
                        sh '''
                            cp --remove-destination "$ENV_FILE" .env
                            docker compose down
                            docker compose --env-file .env up -d
                            rm -f .env
                        '''
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🔎 Vérification des containers Docker
        // ─────────────────────────────────────────────────────────────
        stage('Verify Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {

        // ─────────────────────────────────────────────────────────────
        // ✅ Pipeline réussi
        // Notification email + rapport SonarQube
        // ─────────────────────────────────────────────────────────────
        success {
            echo 'Déploiement réussi ✅'
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — SUCCESS",
                body: """Pipeline SUCCESS ✅

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString}

[Quality]
SonarQube : PASSED ✅
Report    : http://172.17.0.1:9000/dashboard?id=fullStack_portfolio

[Artifacts]
Backend  : ${env.DOCKHUB_USER}/${env.BACKEND_IMAGE}:${env.BUILD_NUMBER}
Frontend : ${env.DOCKHUB_USER}/${env.FRONTEND_IMAGE}:${env.BUILD_NUMBER}

[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }

        // ─────────────────────────────────────────────────────────────
        // ❌ Pipeline échoué
        // Notification + lien vers console Jenkins
        // ─────────────────────────────────────────────────────────────
        failure {
            echo 'Pipeline échoué ❌'
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — FAILURE",
                body: """Pipeline FAILURE ❌

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString}

Stage    : ${env.STAGE_NAME}

[Quality]
SonarQube : FAILED ❌
Report    : http://172.17.0.1:9000/dashboard?id=fullStack_portfolio

[Action Required]
Corrige les problèmes détectés dans SonarQube puis relance le pipeline.

[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }
    }
}