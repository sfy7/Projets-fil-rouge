pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "portfolio-backend"
        FRONTEND_IMAGE = "portfolio-frontend"
        DOCKHUB_USER   = "sfy7"

        // URL de votre instance SonarQube (Docker ou externe)
        SONAR_HOST_URL = "http://localhost:9000"
    }

    stages {

        // ── Étape 1 : Récupération du code source ──────────────────────────
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_creds',
                    url: 'https://github.com/sfy7/Projets-fil-rouge.git'
            }
        }

        // ── Étape 2 : Analyse SonarQube (Backend + Frontend) ─────────────
        //   - Credential "Secret text" avec l'ID 'sonarqube-token'
        //   - Serveur déclaré sous le nom 'SonarQube' dans Configure System
        stage('SonarQube Analysis') {
            steps {
                dir('DevOps') {
                    withSonarQubeEnv('SonarQube') {
                        withCredentials([string(credentialsId: 'sonarqube-token', variable: 'SONAR_TOKEN')]) {
                            sh """
                                docker run --rm \
                                    --network devops_app-network \
                                    --add-host=host.docker.internal:host-gateway \
                                    -e SONAR_HOST_URL=http://host.docker.internal:9000 \
                                    -e SONAR_TOKEN=${SONAR_TOKEN} \
                                    -v \$(pwd):/usr/src \
                                    sonarsource/sonar-scanner-cli:latest
                            """
                        }
                    }
                }
            }
        }

        // ── Étape 3 : Quality Gate — bloque le pipeline si KO ─────────────
        stage('Quality Gate') {
            steps {
                // Attend le résultat du Quality Gate SonarQube (timeout 5 min)
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ── Étape 4 : Build image Docker Backend ──────────────────────────
        stage('Build Backend') {
            steps {
                dir('DevOps/Backend') {
                    sh 'docker build -t $BACKEND_IMAGE .'
                }
            }
        }

        // ── Étape 5 : Build image Docker Frontend ─────────────────────────
        stage('Build Frontend') {
            steps {
                dir('DevOps/Frontend') {
                    sh 'docker build -t $FRONTEND_IMAGE .'
                }
            }
        }

        // ── Étape 6 : Push des images vers Docker Hub ─────────────────────
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub_creds',
                    usernameVariable: 'DOCKHUB_USER',
                    passwordVariable: 'DOCKHUB_PASS'
                )]) {
                    sh 'echo "$DOCKHUB_PASS" | docker login -u "$DOCKHUB_USER" --password-stdin'

                    sh 'docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:latest'
                    sh 'docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}'
                    sh 'docker push $DOCKHUB_USER/$BACKEND_IMAGE:latest'
                    sh 'docker push $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}'

                    sh 'docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:latest'
                    sh 'docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}'
                    sh 'docker push $DOCKHUB_USER/$FRONTEND_IMAGE:latest'
                    sh 'docker push $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}'

                    sh 'docker logout'
                }
            }
        }

        // ── Étape 7 : Démarrage des conteneurs ────────────────────────────
        stage('Start Containers') {
            steps {
                withCredentials([file(credentialsId: 'portfolio-env', variable: 'ENV_FILE')]) {
                    dir('DevOps') {
                        sh 'cp --remove-destination "$ENV_FILE" .env'
                        sh 'docker compose down'
                        sh 'docker compose --env-file .env up -d'
                        sh 'rm -f .env'
                    }
                }
            }
        }

        // ── Étape 8 : Vérification des conteneurs ─────────────────────────
        stage('Verify Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    post {
        success {
            echo 'Déploiement réussi ✅'
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — ${env.JOB_NAME} — SUCCESS",
                body: """Pipeline Execution Report — BUILD #${env.BUILD_NUMBER}
Status   : SUCCESS ✅

Job      : ${env.JOB_NAME}
Duration : ${currentBuild.durationString}

[Deployment]
Backend  : ${env.DOCKHUB_USER}/${env.BACKEND_IMAGE}:${env.BUILD_NUMBER}
Frontend : ${env.DOCKHUB_USER}/${env.FRONTEND_IMAGE}:${env.BUILD_NUMBER}
Registry : Docker Hub

[Code Quality]
Engine   : SonarQube Static Analysis
Status   : Quality Gate PASSED — No critical issues detected.
Report   : ${SONAR_HOST_URL}/dashboard?id=portfolio

[Links]
Console  : ${env.BUILD_URL}console""",
                to: "safietou0218@gmail.com"
            )
        }
        failure {
            echo 'Pipeline échoué ❌'
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — ${env.JOB_NAME} — FAILURE",
                body: """Pipeline Execution Report — BUILD #${env.BUILD_NUMBER}
Status   : FAILURE ❌

Job      : ${env.JOB_NAME}
Duration : ${currentBuild.durationString}
Stage    : ${env.STAGE_NAME}

[Code Quality]
Engine   : SonarQube Static Analysis
Status   : Quality Gate FAILED — Critical issues detected. Deployment has been aborted.
Report   : ${SONAR_HOST_URL}/dashboard?id=portfolio

[Action Required]
The pipeline has failed. Please review the SonarQube report, fix the detected issues and re-trigger the build.

[Links]
Console  : ${env.BUILD_URL}console""",
                to: "safietou0218@gmail.com"
            )
        }
    }
}