pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "portfolio-backend"
        FRONTEND_IMAGE = "portfolio-frontend"
        DOCKHUB_USER   = "sfy7"
        SCANNER_HOME   = tool 'SonarQube Scanner'
        K8S_NAMESPACE  = "portfolio"
    }

    stages {

        // ─────────────────────────────────────────────────────────────
        // 📥 Clone du dépôt Git
        // ─────────────────────────────────────────────────────────────
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_creds',
                    url: 'https://github.com/sfy7/Projets-fil-rouge.git'
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🔍 Analyse SonarQube
        // ─────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                dir('DevOps') {
                    withSonarQubeEnv('SonarQube') {
                        sh '$SCANNER_HOME/bin/sonar-scanner -Dproject.settings=sonar-project.properties'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🧪 Quality Gate
        // ─────────────────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🐳 Build des images Docker (en parallèle)
        // ─────────────────────────────────────────────────────────────
        stage('Build Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        dir('DevOps/Backend') {
                            sh 'docker build -t $BACKEND_IMAGE .'
                        }
                    }
                }
                stage('Build Frontend') {
                    steps {
                        dir('DevOps/Frontend') {
                            sh 'docker build -t $FRONTEND_IMAGE .'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🚀 Push vers Docker Hub
        // ─────────────────────────────────────────────────────────────
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub_creds',
                    usernameVariable: 'DOCKHUB_USER_CRED',
                    passwordVariable: 'DOCKHUB_PASS'
                )]) {
                    sh '''
                        echo "$DOCKHUB_PASS" | docker login -u "$DOCKHUB_USER_CRED" --password-stdin

                        docker tag $BACKEND_IMAGE  $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker tag $BACKEND_IMAGE  $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}
                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}

                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:latest
                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:latest
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}

                        docker logout
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // ☸️  Déploiement Kubernetes
        // ─────────────────────────────────────────────────────────────
        stage('Deploy to Kubernetes') {
            steps {
                dir('DevOps') {
                    sh '''
                        # ── Namespace ──
                        kubectl apply -f K8s/Base/namespace.yaml

                        # ── ConfigMap + Secret ──
                        kubectl apply -f K8s/Base/configmap-and-secret.yaml

                        # ── Services (tous regroupés) ──
                        kubectl apply -f K8s/services.yaml

                        # ── MongoDB : apply uniquement si pas déjà prêt ──
                        MONGO_READY=$(kubectl get statefulset/mongo -n $K8S_NAMESPACE \
                            -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")
                        if [ "$MONGO_READY" = "1" ]; then
                            echo "✅ MongoDB déjà prêt, apply ignoré"
                        else
                            echo "⏳ Déploiement de MongoDB..."
                            kubectl apply -f K8s/mongodb.yaml
                            kubectl rollout status statefulset/mongo \
                                -n $K8S_NAMESPACE --timeout=300s
                        fi

                        # ── Backend ──
                        kubectl apply -f K8s/backend.yaml
                        kubectl set image deployment/backend-deployment \
                            backend=$DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER} \
                            -n $K8S_NAMESPACE
                        echo "⏳ Attente du Backend..."
                        kubectl rollout status deployment/backend-deployment \
                            -n $K8S_NAMESPACE --timeout=300s

                        # ── Frontend ──
                        kubectl apply -f K8s/frontend.yaml
                        kubectl set image deployment/frontend-deployment \
                            frontend=$DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER} \
                            -n $K8S_NAMESPACE
                        echo "⏳ Attente du Frontend..."
                        kubectl rollout status deployment/frontend-deployment \
                            -n $K8S_NAMESPACE --timeout=300s
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🔎 Vérification
        // ─────────────────────────────────────────────────────────────
        
        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "=== Pods ==="
                    kubectl get pods -n portfolio
                    echo ""
                    echo "=== Services ==="
                    kubectl get services -n portfolio
                    echo ""
                    echo "=== URL Frontend ==="
                    NODEPORT=$(kubectl get svc frontend-service -n portfolio -o jsonpath='{.spec.ports[0].nodePort}')
                    NODE_IP=$(kubectl get nodes -o jsonpath='{.items[0].status.addresses[0].address}')
                    echo "Frontend accessible sur: http://${NODE_IP}:${NODEPORT}"
                '''
            }
        }
    }

    post {

        success {
            echo 'Déploiement Kubernetes réussi ✅'
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — SUCCESS ✅",
                body: """Pipeline SUCCESS ✅

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString.replace(' and counting', '')}

[Quality]
SonarQube : PASSED ✅
Report    : http://localhost:9000/dashboard?id=fullStack_portfolio

[Artifacts]
Backend  : ${env.DOCKHUB_USER}/${env.BACKEND_IMAGE}:${env.BUILD_NUMBER} pushed to Docker Hub
Frontend : ${env.DOCKHUB_USER}/${env.FRONTEND_IMAGE}:${env.BUILD_NUMBER} pushed to Docker Hub

[Kubernetes]
Namespace : portfolio
Pods      : kubectl get pods -n portfolio
Frontend  : http://192.168.49.2:30080

[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }

        failure {
            echo 'Pipeline échoué ❌ — Rollback en cours...'
            sh '''
                kubectl rollout undo deployment/backend-deployment  -n portfolio || true
                kubectl rollout undo deployment/frontend-deployment -n portfolio || true
            '''
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — FAILURE ❌",
                body: """Pipeline FAILURE ❌

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString}

Stage en échec : ${env.STAGE_NAME}

[Quality]
SonarQube : http://localhost:9000/dashboard?id=fullStack_portfolio

[Kubernetes]
Rollback automatique effectué vers la version précédente.

[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }
    }
}