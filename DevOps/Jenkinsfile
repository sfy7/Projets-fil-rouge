pipeline {
    agent any

    environment {
        BACKEND_IMAGE  = "portfolio-backend"
        FRONTEND_IMAGE = "portfolio-frontend"
        DOCKHUB_USER   = "sfy7"
        SCANNER_HOME   = tool 'SonarQube Scanner'
        K8S_NAMESPACE  = "portfolio"
        // ── Terraform ──────────────────────────────────────────────
        TF_DIR         = "DevOps/Terraform/terraform-k8s-deploy"
       
    }

    stages {

        // ─────────────────────────────────────────────────────────────
        // 📥 Clone du dépôt Git
        // ─────────────────────────────────────────────────────────────
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_creds',
                    url: 'https://github.com/sfy7/Projets-fil-rouge.git'
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🛡️ Trivy — Scan du code source (target = Filesystem)
        // Scanners activés :
        //   - vuln   : vulnérabilités dans les dépendances (package.json, package-lock.json...)
        //   - secret : secrets oubliés dans le code (clés API, mots de passe, tokens...)
        //   - license: licences open-source potentiellement problématiques
        // ─────────────────────────────────────────────────────────────
        stage('Trivy - Scan Filesystem') {
            steps {
                dir('DevOps') {
                    sh '''
                        mkdir -p trivy-reports

                        trivy fs \
                            --scanners vuln,secret,license \
                            --severity HIGH,CRITICAL \
                            --format template \
                            --template "@trivy-html.tpl" \
                            --output trivy-reports/trivy-fs-report.html \
                            --exit-code 0 \
                            .
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🛡️ Trivy — Scan des fichiers d'infrastructure (target = Config / IaC)
        // Cherche des MAUVAISES CONFIGURATIONS (pas des CVE) dans :
        //   - les Dockerfile (Backend/Frontend)
        //   - les manifestes Kubernetes (K8s/*.yaml)
        //   - le code Terraform (Terraform/**)
        // Ex : conteneur lancé en root, absence de limites CPU/RAM, S3 public...
        // ─────────────────────────────────────────────────────────────
        stage('Trivy - Scan IaC (Misconfigurations)') {
            steps {
                dir('DevOps') {
                    sh '''
                        mkdir -p trivy-reports

                        trivy config \
                            --severity HIGH,CRITICAL \
                            --format template \
                            --template "@trivy-html.tpl" \
                            --output trivy-reports/trivy-iac-report.html \
                            --exit-code 0 \
                            .
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🔍 Analyse SonarQube
        // ─────────────────────────────────────────────────────────────
        stage('SonarQube Analysis') {
            steps {
                dir('DevOps') {
                    withSonarQubeEnv('SonarQube') {
                        sh '$SCANNER_HOME/bin/sonar-scanner -Dproject.settings=sonar-project.properties'
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🧪 Quality Gate
        // ─────────────────────────────────────────────────────────────
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🐳 Build des images Docker (en parallèle)
        // ─────────────────────────────────────────────────────────────
        stage('Build Images') {
            parallel {
                stage('Build Backend') {
                    steps {
                        dir('DevOps/Backend') {
                            sh 'docker build -t $BACKEND_IMAGE .'
                        }
                    }
                }
                stage('Build Frontend') {
                    steps {
                        dir('DevOps/Frontend') {
                            sh 'docker build -t $FRONTEND_IMAGE .'
                        }
                    }
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🛡️ Trivy — Scan des images Docker (target = Container Image)
        // On scanne l'image APRES le build mais AVANT de la pousser sur
        // Docker Hub : inutile de publier une image vulnérable.
        // Scanner "vuln" = vulnérabilités connues (CVE) dans :
        //   - l'OS de base (Alpine/Nginx)
        //   - les paquets npm installés dans l'image
        // exit-code 1 = le build ECHOUE si une faille CRITICAL est trouvée
        // (c'est notre "Quality Gate" sécurité, comme pour SonarQube)
        // ─────────────────────────────────────────────────────────────
        stage('Trivy - Scan Images') {
            steps {
                dir('DevOps') {
                    sh '''
                        mkdir -p trivy-reports

                        trivy image \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --ignorefile .trivyignore \
                            --format template \
                            --template "@trivy-html.tpl" \
                            --output trivy-reports/trivy-image-backend.html \
                            --exit-code 1 \
                            $BACKEND_IMAGE

                        trivy image \
                            --scanners vuln \
                            --severity HIGH,CRITICAL \
                            --ignorefile .trivyignore \
                            --format template \
                            --template "@trivy-html.tpl" \
                            --output trivy-reports/trivy-image-frontend.html \
                            --exit-code 1 \
                            $FRONTEND_IMAGE
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🏷️ Tag & Push vers Docker Hub
        // ─────────────────────────────────────────────────────────────
        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub_creds',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin

                        # Tag avec le numéro de build ET latest
                        docker tag $BACKEND_IMAGE  $DOCKHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER
                        docker tag $BACKEND_IMAGE  $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER
                        docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:latest

                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:$BUILD_NUMBER
                        docker push $DOCKHUB_USER/$BACKEND_IMAGE:latest
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:$BUILD_NUMBER
                        docker push $DOCKHUB_USER/$FRONTEND_IMAGE:latest
                    '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🏗️ Terraform Init & Plan
        // Prévisualise ce que Terraform va déployer — sans rien modifier
        // ─────────────────────────────────────────────────────────────
        stage('Terraform Plan') {
            steps {
                dir("${TF_DIR}") {
                        sh '''
                            # Initialise Terraform (télécharge le provider Kubernetes)
                            terraform init -input=false

                            # Affiche le plan de déploiement avec le tag du build actuel
                            terraform plan \
                                -var="image_tag=${BUILD_NUMBER}" \
                                -out=tfplan
                        '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🚀 Terraform Apply
        // Déploie l'application sur le cluster Kubernetes
        // Remplace les anciens : kubectl apply -f K8s/*.yaml
        //                        kubectl set image deployment/...
        // ─────────────────────────────────────────────────────────────
        stage('Terraform Apply') {
            steps {
                dir("${TF_DIR}") {
                        sh '''
                            # Applique le plan sauvegardé (-auto-approve = pas de prompt "yes")
                            terraform apply -auto-approve tfplan
                        '''
                }
            }
        }

        // ─────────────────────────────────────────────────────────────
        // ✅ Vérification du déploiement
        // ─────────────────────────────────────────────────────────────
        stage('Verify Deployment') {
            steps {
                sh '''
                    echo "=== Pods en cours ==="
                    kubectl get pods -n $K8S_NAMESPACE

                    echo ""
                    echo "=== Services ==="
                    kubectl get services -n $K8S_NAMESPACE

                    echo ""
                    echo "=== Attente que les pods soient Ready ==="
                    kubectl rollout status deployment/backend-deployment  -n $K8S_NAMESPACE --timeout=120s
                    kubectl rollout status deployment/frontend-deployment -n $K8S_NAMESPACE --timeout=120s
                '''
            }
        }

        // ─────────────────────────────────────────────────────────────
        // 🛡️ Trivy — Scan du cluster Kubernetes live (target = k8s)
        // Scanne les ressources déployées dans le namespace portfolio :
        //   - pods / deployments / statefulsets : vulnérabilités dans les images en cours d'exécution
        //   - configs : mauvaises pratiques (conteneur root, absence de securityContext, secrets en clair...)
        //   - rbac    : permissions trop larges sur les ServiceAccounts
        // Exécuté APRÈS le déploiement pour auditer l'état réel du cluster.
        // exit-code 0 = non bloquant (audit post-déploiement, pas un gate)
        // ─────────────────────────────────────────────────────────────
        stage('Trivy - Scan Kubernetes Cluster') {
            steps {
                dir('DevOps') {
                    sh '''
                        mkdir -p trivy-reports

                        trivy k8s \
                            --severity HIGH,CRITICAL \
                            --scanners vuln,misconfig,secret,rbac \
                            --format template \
                            --template "@trivy-html.tpl" \
                            --report all \
                            --output trivy-reports/trivy-k8s-report.html \
                            --exit-code 0 \
                            --include-namespaces $K8S_NAMESPACE
                    '''
                }
            }
        }
    }

    // ─────────────────────────────────────────────────────────────────
    // Post-build : notifications email
    // ─────────────────────────────────────────────────────────────────
    post {
        always {
            // Archive tous les rapports Trivy (fs, iac, images) quel que soit
            // le résultat du build, pour pouvoir les consulter dans Jenkins
            // (menu "Build Artifacts").
            archiveArtifacts artifacts: 'DevOps/trivy-reports/*.html,DevOps/trivy-reports/*.txt', allowEmptyArchive: true
            // Rapports générés : trivy-fs-report.txt, trivy-iac-report.txt,
            //                    trivy-image-backend.txt, trivy-image-frontend.txt,
            //                    trivy-k8s-report.txt
        }
        success {
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — SUCCESS ✅",
                body: """Pipeline SUCCESS ✅

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString}

[Quality]
SonarQube : PASSED ✅
Report    : http://localhost:9000/dashboard?id=fullStack_portfolio

[Sécurité - Trivy]
Filesystem (vuln/secret/license) : voir trivy-fs-report.html
IaC (Dockerfile/K8s/Terraform)   : voir trivy-iac-report.html
Images Docker (CVE)              : AUCUNE faille CRITICAL ✅
Kubernetes cluster (live audit)  : voir trivy-k8s-report.html
Rapports complets dans les artefacts du build Jenkins

[Artifacts]
Backend  : ${env.DOCKHUB_USER}/portfolio-backend:${env.BUILD_NUMBER} pushed to Docker Hub
Frontend : ${env.DOCKHUB_USER}/portfolio-frontend:${env.BUILD_NUMBER} pushed to Docker Hub

[Terraform]
Déploiement effectué via Terraform ✅
Image tag : ${env.BUILD_NUMBER}

[Kubernetes]
Pods      : kubectl get pods -n portfolio
Frontend  : http://192.168.49.2:30080


[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }

        failure {
            echo 'Pipeline échoué ❌ — Rollback en cours...'
            // Rollback via Terraform : redéploie avec le tag précédent
            // (ou via kubectl en dernier recours)
            sh '''
                kubectl rollout undo deployment/backend-deployment  -n portfolio || true
                kubectl rollout undo deployment/frontend-deployment -n portfolio || true
            '''
            emailext (
                subject: "[Jenkins] Build #${env.BUILD_NUMBER} — FAILURE ❌",
                body: """Pipeline FAILURE ❌

Job      : ${env.JOB_NAME}
Build    : #${env.BUILD_NUMBER}
Duration : ${currentBuild.durationString}

Stage en échec : ${env.STAGE_NAME}

[Kubernetes]
Rollback automatique effectué vers la version précédente.

[Console]
${env.BUILD_URL}console
""",
                to: "safietou0218@gmail.com"
            )
        }
    }
}
