pipeline {
    // Agent Jenkins : ici "any" signifie que le pipeline peut s'exécuter sur n'importe quel agent disponible
    agent any

    // Variables globales utilisées dans tout le pipeline (images Docker)
    environment {
        BACKEND_IMAGE  = "portfolio-backend"
        FRONTEND_IMAGE = "portfolio-frontend"
        DOCKHUB_USER = "sfy7"   // ← Username DockerHub
    }

    stages {
        // Étape 1 : Récupération du code source depuis GitHub
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github_creds',
                    url: 'https://github.com/sfy7/Projets-fil-rouge.git'
            }
        }

        // Étape 2 : Construction de l'image Docker du backend
        stage('Build Backend') {
            steps {
                dir('DevOps/Backend') {
                    sh 'docker build -t $BACKEND_IMAGE .'
                }
            }
        }

        // Étape 3 : Construction de l'image Docker du frontend
        stage('Build Frontend') {
            steps {
                dir('DevOps/Frontend') {
                    sh 'docker build -t $FRONTEND_IMAGE .'
                }
            }
        }

        // Étape 4 : Push des images vers Docker Hub
        stage('Push to Docker Hub') {
            steps {
                // 'dockerhub_creds' = ID du credential Jenkins (type Username/Password)
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub_creds',
                    usernameVariable: 'DOCKHUB_USER',
                    passwordVariable: 'DOCKHUB_PASS'
                )]) {
                    // Connexion à Docker Hub
                    sh 'echo "$DOCKHUB_PASS" | docker login -u "$DOCKHUB_USER" --password-stdin'

                    // Tag du backend avec :latest et :numéro de build
                    sh 'docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:latest'
                    sh 'docker tag $BACKEND_IMAGE $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}'

                    // Push du backend vers Docker Hub
                    sh 'docker push $DOCKHUB_USER/$BACKEND_IMAGE:latest'
                    sh 'docker push $DOCKHUB_USER/$BACKEND_IMAGE:${BUILD_NUMBER}'

                    // Tag du frontend avec :latest et :numéro de build
                    sh 'docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:latest'
                    sh 'docker tag $FRONTEND_IMAGE $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}'

                    // Push du frontend vers Docker Hub
                    sh 'docker push $DOCKHUB_USER/$FRONTEND_IMAGE:latest'
                    sh 'docker push $DOCKHUB_USER/$FRONTEND_IMAGE:${BUILD_NUMBER}'

                    // Déconnexion pour ne pas laisser la session ouverte sur le serveur
                    sh 'docker logout'
                }
            }
        }

        // Étape 5 : Démarrage des conteneurs avec Docker Compose
        stage('Start Containers') {
            steps {
                // Récupère le fichier .env stocké dans les credentials Jenkins
                withCredentials([file(credentialsId: 'portfolio-env', variable: 'ENV_FILE')]) {
                    dir('DevOps') {   // ← le dossier qui CONTIENT docker-compose.yaml
                        // Copie le .env secret dans le dossier DevOps
                        sh 'cp --remove-destination "$ENV_FILE" .env'
                        // Arrête les anciens conteneurs
                        sh 'docker compose down'
                        // Démarre tous les services (mongo + backend + frontend)
                        sh 'docker compose --env-file .env up -d'
                        // Supprime le .env pour ne pas le laisser sur le serveur
                        sh 'rm -f .env'
                    }
                }
            }
        }

        // Étape 6 : Vérification que les conteneurs sont bien en cours d'exécution
        stage('Verify Containers') {
            steps {
                sh 'docker ps'
            }
        }
    }

    // Actions exécutées après l'exécution du pipeline
    post {
        success {
            echo 'Déploiement réussi ✅'
            emailext (
                subject: "✅ BUILD #${env.BUILD_NUMBER} — SUCCESS",
                body: """✅ BUILD #${env.BUILD_NUMBER} — SUCCESS
Job      : ${env.JOB_NAME}
Duration : ${currentBuild.durationString}
Images   : ${env.BACKEND_IMAGE}:${env.BUILD_NUMBER} / ${env.FRONTEND_IMAGE}:${env.BUILD_NUMBER} pushed to Docker Hub
Logs     : ${env.BUILD_URL}console""",
                to: "safietou0218@gmail.com"
            )
        }
        failure {
            echo 'Pipeline échoué ❌'
            emailext (
                subject: "❌ BUILD #${env.BUILD_NUMBER} — FAILURE",
                body: """❌ BUILD #${env.BUILD_NUMBER} — FAILURE
The pipeline has failed. Please check the logs for more details.
 
Job      : ${env.JOB_NAME}
Duration : ${currentBuild.durationString}
Stage    : ${env.STAGE_NAME}
Logs     : ${env.BUILD_URL}console""",
                to: "safietou0218@gmail.com"
            )
        }
    }
        
}